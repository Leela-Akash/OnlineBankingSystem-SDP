# ====================================================================
# Nexus Online Banking System - Environment Configuration Example
# ====================================================================

# MySQL Database
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=online_banking
MYSQL_USER=banking_user
MYSQL_PASSWORD=banking_secure_pass

# Backend Application
PORT=8080
DB_URL=jdbc:mysql://mysql:3306/online_banking?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=banking_user
DB_PASSWORD=banking_secure_pass
SPRING_PROFILES_ACTIVE=prod

# JWT Authentication (Base64-encoded, minimum 256-bit / 32 characters)
JWT_SECRET=c2VjdXJlQmFua2luZ1N5c3RlbVNlY3JldEtleUZvckpXVFRva2VuR2VuZXJhdGlvbjEyMzQ1Ng==
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# CORS Whitelist (comma-delimited)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# Frontend Configuration
VITE_API_URL=http://localhost:8080
